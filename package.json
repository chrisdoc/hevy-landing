{
  "name": "hevy-mcp-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test",
    "format": "prettier --plugin prettier-plugin-astro --write src test astro.config.mjs package.json tsconfig.json wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "astro": "7.3.5",
    "astro-llms-md": "^3.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "6.0.3",
    "wrangler": "4.140.0"
  }
}
