---
import "@fontsource-variable/dm-sans";
import "@fontsource-variable/manrope";
import "../styles/homepage.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Hevy MCP"
  description="The requested Hevy MCP page could not be found."
  canonicalPath="/404/"
>
  <header class="wrap nav">
    <a class="wordmark" href="/" aria-label="Hevy MCP home">
      hevy<span>/mcp</span>
    </a>
    <nav aria-label="Main navigation">
      <a href="/#possibilities">What it does</a>
      <a href="/#how">How it works</a>
      <a class="nav-cta" href="/#setup">
        Set up
      </a>
    </nav>
  </header>
  <main id="main-content" class="hero wrap not-found">
    <div class="hero-copy">
      <p class="eyebrow">404 · PAGE NOT FOUND</p>
      <h1>
        This page
        <br />
        <span>isn't here.</span>
      </h1>
      <p class="intro">
        This address doesn’t point to a page on Hevy MCP. Head back home or jump
        to the setup guide.
      </p>
      <div class="actions">
        <a class="button lime" href="/">
          Back to home <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/#setup">
          View setup guide
        </a>
      </div>
    </div>
    <aside class="conversation" aria-label="Page status">
      <div class="conversation-top">
        <span>ROUTE STATUS</span>
        <span class="example">404</span>
      </div>
      <div class="assistant-message">
        <p class="response-label">HEVY MCP</p>
        <h2>Everything else is still here.</h2>
        <p>
          Browse what the connector can do, or follow the setup steps to get
          started.
        </p>
      </div>
    </aside>
  </main>
  <footer class="wrap">
    <div>
      <a class="wordmark" href="/" aria-label="Hevy MCP home">
        hevy<span>/mcp</span>
      </a>
      <p>
        Built by Christoph Kieslich. Open source under the MIT license.
        <br />
        Not an official Hevy product.
      </p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/chrisdoc/hevy-mcp">GitHub project ↗</a>
      <a href="https://www.npmjs.com/package/hevy-mcp">npm package ↗</a>
      <a href="https://github.com/chrisdoc/hevy-mcp/issues">
        Report an issue ↗
      </a>
      <a href="https://github.com/chrisdoc/hevy-mcp/blob/main/LICENSE">
        MIT License ↗
      </a>
    </div>
  </footer>
</BaseLayout>
